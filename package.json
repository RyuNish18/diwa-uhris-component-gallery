{
  "name": "@diwauhris/ui",
  "private": false,
  "version": "1.7.46",
  "type": "module",
  "description": "DIWA UHRIS UI component library — React + Tailwind CSS",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "tailwindcss",
    "diwa",
    "uhris"
  ],
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/types/ui-library/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs",
      "types": "./lib/types/ui-library/index.d.ts"
    },
    "./styles.css": "./lib/assets/ui.css",
    "./lib/assets/ui.css": "./lib/assets/ui.css"
  },
  "files": [
    "lib",
    "!lib/**/*.map"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:css": "vite build --config vite.css.config.ts",
    "build:dts": "tsc --project tsconfig.lib.json --outDir lib/types",
    "build:lib": "tsc -b && vite build --config vite.lib.config.ts && npm run build:css && npm run build:dts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs",
    "test:audit": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --verbose",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1",
    "@radix-ui/react-popover": "^1",
    "@radix-ui/react-tooltip": "^1",
    "clsx": "^2",
    "d3": "^7",
    "date-fns": "^4",
    "lucide-react": ">=0.363.0",
    "react": ">=18",
    "react-calendar": "^6",
    "react-dom": ">=18",
    "react-router-dom": "^7",
    "sonner": "^2",
    "tailwind-merge": "^3"
  },
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource/barlow": "^5.3.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.2",
    "babel-jest": "^30.4.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3"
  }
}
